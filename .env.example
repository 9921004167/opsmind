# Copy this file to .env and fill in real values. Never commit the actual .env file.

# --- Postgres ---
POSTGRES_DB=opsmind
POSTGRES_USER=opsmind
POSTGRES_PASSWORD=change-me-locally

# --- OpsMind core service ---
# Must be at least 32 bytes. Generate one with: openssl rand -base64 48
OPSMIND_JWT_SECRET=change-me-to-a-real-random-secret-at-least-32-bytes-long
OPSMIND_JWT_EXPIRATION_MINUTES=60
OPSMIND_SERVER_PORT=8080

# --- Kafka ---
# Only needed if running opsmind-core outside docker-compose (see application-local.yml).
OPSMIND_KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# --- Redis ---
# Reserved for Phase 2+ (caching / rate limiting). Not read by any Phase 1 code path yet.
OPSMIND_REDIS_HOST=localhost
OPSMIND_REDIS_PORT=6379

# --- Reserved for later phases (do not set yet - no code reads these in Phase 1) ---
# GEMINI_API_KEY=

# --- E-commerce reference app (Phase 2) ---
ECOMMERCE_DB_ADMIN_PASSWORD=change-me-locally
CATALOG_DB_PASSWORD=change-me-locally
ORDER_DB_PASSWORD=change-me-locally
PAYMENT_DB_PASSWORD=change-me-locally
INVENTORY_DB_PASSWORD=change-me-locally

# Shared secret required by every /faults/** endpoint (payment, inventory, order).
# Generate one the same way as OPSMIND_JWT_SECRET.
FAULT_ADMIN_TOKEN=change-me-to-a-real-random-secret
